NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:3000
# Set securely using setup-private-config.ps1 (MongoDB Atlas account).
MONGODB_URI=mongodb://127.0.0.1:27017/sakib_portfolio
FIREBASE_PROJECT_ID=mdsakibmollahportfolio
# Base64 encode a Firebase service account JSON file. NEVER commit the JSON or encoded value.
FIREBASE_SERVICE_ACCOUNT_JSON_B64=
# Local setup uses Application Default Credentials via an absolute JSON path.
# Keep the file OUTSIDE the git repository.
GOOGLE_APPLICATION_CREDENTIALS=
# Or use GOOGLE_APPLICATION_CREDENTIALS on supported Google runtimes.
ADMIN_EMAILS=ceh.fdr.mdsakibmollah@gmail.com
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
RESEND_API_KEY=
RESEND_FROM_EMAIL=Portfolio <portfolio@your-verified-domain.com>
OWNER_NOTIFICATION_EMAIL=ceh.fdr.mdsakibmollah@gmail.com
